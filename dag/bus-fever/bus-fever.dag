# Bus Fever — game-local tuning (prefix: bus_fever_).
# Canonical gameplay: vault "Ad Game Clones/bus-fever-gameplay.md"
# (parking-lot escape + ordered color queue — v2; supersedes spawn-management v1).

# —— Board size ——
CALC bus_fever_buses = min(9, 4 + (bus_fever_level - 1) / 2)
CALC bus_fever_colors = min(6, 3 + (bus_fever_level - 1) / 3)
CALC bus_fever_capacity = min(6, 4 + (bus_fever_level - 1) / 4)

# —— Blocker cars (from level 6, cap 3) ——
CALC bus_fever_cars = min(3, max(0, (bus_fever_level - 6) / 2))

# —— Queue pressure ——
VAR bus_fever_queue_cap_base = 14
VAR bus_fever_queue_cap_max = 18
CALC bus_fever_queue_cap = min(bus_fever_queue_cap_max, bus_fever_queue_cap_base + (bus_fever_level - 1) / 3)

VAR bus_fever_arrival_start = 4.2
VAR bus_fever_arrival_min = 2.0
VAR bus_fever_arrival_step = 0.15
CALC bus_fever_arrival_interval = max(bus_fever_arrival_min, bus_fever_arrival_start - (bus_fever_level - 1) * bus_fever_arrival_step)

VAR bus_fever_seed_queue_base = 5
CALC bus_fever_seed_queue = min(10, bus_fever_seed_queue_base + (bus_fever_level - 1) / 2)

# —— Bays: 2 normally; 1 on tight levels (every 5th). The grammar has no
# truncation/modulo (L/5*5==L is a float identity), so tight levels are explicit. ——
CALC bus_fever_bays = 2 - (bus_fever_level == 5 || bus_fever_level == 10 || bus_fever_level == 15 || bus_fever_level == 20)

# —— Rewards ——
CALC bus_fever_goal = 0   # retired v1 token (kept so saves don't break)
CALC bus_fever_streak_bonus = min(bus_fever_streak, meta_streak_bonus_max)
CALC bus_fever_coins_win = 20 + bus_fever_level * 10

# —— Progression entities (unchanged from v1) ——
DEF PROGRESSION bus_fever_slot4 NAME="Extra Bay Preview" EMOJI="🅿️" ORDER=2 MAX=1 DESC="Third loading bay on non-tight levels. Unlocks at level 8."
COST bus_fever_slot4 BASE=400 coin
REVEALUNLOCK bus_fever_slot4 bus_fever_level >= 8

DEF PROGRESSION bus_fever_slow_walker NAME="Slow Walkers" EMOJI="🐢" ORDER=3 MAX=1 DESC="VIP passengers that board slowly but count double. From level 10."
COST bus_fever_slow_walker BASE=300 coin
REVEALUNLOCK bus_fever_slow_walker bus_fever_level >= 10
