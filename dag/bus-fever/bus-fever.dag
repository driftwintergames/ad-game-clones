# Bus Fever — game-local tuning (prefix: bus_fever_).
# Spec: vault "Ad Game Clones/bus-fever.md". Numbers mirror the spec.

VAR bus_fever_grid_w = 5
VAR bus_fever_grid_h = 8
VAR bus_fever_capacity = 8         # passengers per bus
VAR bus_fever_slots = 3            # parking slots
VAR bus_fever_refill_s = 3.0       # slot refill delay after departure
VAR bus_fever_goal_base = 30       # L1 board quota

# Arrival rate: L1 1/1.8s -> L15 1/0.9s, linear in level.
VAR bus_fever_arrival_start = 1.8
VAR bus_fever_arrival_end = 0.9
VAR bus_fever_arrival_level_end = 15
CALC bus_fever_arrival_interval = max(bus_fever_arrival_end, bus_fever_arrival_start - (bus_fever_arrival_start - bus_fever_arrival_end) * (bus_fever_level - 1) / (bus_fever_arrival_level_end - 1))

# Colors: 3 at L1-3, +1 every 3 levels, cap 6.
CALC bus_fever_colors = min(6, 3 + (bus_fever_level - 1) / 3)

# Level goal scales ~1.25x/level.
CALC bus_fever_goal = bus_fever_goal_base * 1.25 ^ (bus_fever_level - 1)

# Streak: consecutive level clears raise per-run coin bonus (shared cap).
CALC bus_fever_streak_bonus = min(bus_fever_streak, meta_streak_bonus_max)

# —— Progression entities (DEF + COST on state stock "coin") ——
DEF PROGRESSION bus_fever_rush_hour NAME="Rush Hour" EMOJI="⚡" ORDER=1 MAX=1 DESC="Booster: 5s of double boarding speed. Unlocks at level 5."
COST bus_fever_rush_hour BASE=200 coin
REVEALUNLOCK bus_fever_rush_hour bus_fever_level >= 5

DEF PROGRESSION bus_fever_slot4 NAME="Fourth Slot" EMOJI="🅿️" ORDER=2 MAX=1 DESC="A fourth parking slot. Unlocks at level 8."
COST bus_fever_slot4 BASE=400 coin
REVEALUNLOCK bus_fever_slot4 bus_fever_level >= 8

DEF PROGRESSION bus_fever_slow_walker NAME="Slow Walkers" EMOJI="🐢" ORDER=3 MAX=1 DESC="Special passengers that block a cell for 5s. Adds spice from level 10."
COST bus_fever_slow_walker BASE=300 coin
REVEALUNLOCK bus_fever_slow_walker bus_fever_level >= 10
