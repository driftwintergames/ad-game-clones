# Bus Fever - game-local tuning (prefix: bus_fever_).
# Contract: vault "Ad Game Clones/bus-fever/spec.md" (v3 rewrite).
# Code = spatial/boarding/side-fill rules; DAG = progression math only.

# Arrival pacing
VAR bus_fever_base_interval = 3500
VAR bus_fever_min_interval = 2000
VAR bus_fever_interval_step = 150
CALC bus_fever_level_interval = max(bus_fever_min_interval, bus_fever_base_interval - (level - 1) * bus_fever_interval_step)

# Bus capacity (5 from L1, 6 from L7 — ad-scale crowds)
VAR bus_fever_base_capacity = 5
VAR bus_fever_max_capacity = 6
# NOTE: grammar has no floor()/modulo (kernel pitfall) — curves stay real-valued
# here; dagService applies Math.floor at consumption per spec 9.2.
CALC bus_fever_level_capacity = min(bus_fever_max_capacity, bus_fever_base_capacity + (level - 1) / 6)

# Bus count (ad-scale: 12 at L2 rising to 30)
VAR bus_fever_base_buses = 12
VAR bus_fever_max_buses = 30
CALC bus_fever_level_buses = min(bus_fever_max_buses, bus_fever_base_buses + (level - 1) / 2)

# Difficulty: color count and queue capacity scale with level
CALC bus_fever_colors = min(6, 3 + (level - 1) / 3)
CALC bus_fever_queue_capacity = min(90, 60 + (level - 1))

# Streak and score
CALC bus_fever_streak_bonus = 100 * pow(streak, 1.25)
CALC bus_fever_coins_win = 20 + level * 10

# Progression entities (kept from v1/v2; no in-game shop - scores/stats only)
DEF PROGRESSION bus_fever_slot4 NAME="Extra Bay Preview" EMOJI="P" ORDER=2 MAX=1 DESC="Third loading bay. Unlocks at level 8."
COST bus_fever_slot4 BASE=400 coin
REVEALUNLOCK bus_fever_slot4 level >= 8

DEF PROGRESSION bus_fever_slow_walker NAME="Slow Walkers" EMOJI="T" ORDER=3 MAX=1 DESC="VIP passengers who board slowly but count double. From level 10."
COST bus_fever_slow_walker BASE=300 coin
REVEALUNLOCK bus_fever_slow_walker level >= 10
