{
  "name": "@repo/bus-fever",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --outDir dist --emptyOutDir",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "pnpm build:native && cap sync",
