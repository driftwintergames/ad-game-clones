    "cap:android": "pnpm cap:sync && cap open android"
  },
  "dependencies": {
    "@adgc/dag-kernel": "workspace:*",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
